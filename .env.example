# OpenAI or compatible provider API credentials
OPENAI_API_KEY=your_api_key_here

# Optional: Custom model name (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: Alternate API base URL (e.g., https://openrouter.ai/api/v1 or http://localhost:11434/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Docker sandbox image tag (default: sandbox-agent)
SANDBOX_IMAGE=sandbox-agent
